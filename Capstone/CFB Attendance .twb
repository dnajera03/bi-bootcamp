  <dashboards>
    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run>20 Years of College Football Attendance</run>
          </formatted-text>
        </title>
      </layout-options>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98020' id='1' param='vert' removable='false' type-v2='layout-flow' w='97768' x='1116' y='990'>
            <zone h='4084' id='3' type-v2='title' w='97768' x='1116' y='990' />
            <zone h='12500' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='97768' x='1116' y='5074' />
            <zone h='81436' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='97768' x='1116' y='17574'>
              <flipboard active-id='6' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='College Football had steady attendance from 2006-2019, until the pandemic in 2020 occured. A return to form occured after 2020' captured-sheet='Total Attendence by Season' id='1' />
                  <story-point caption='The 2020 season saw a big decrease in attendance, it fell from around 42,000 to 8,000. Attendance evetually recovered to its norm. ' captured-sheet='COVID Impact on Attendance' id='2' />
                  <story-point caption='The P5 teams dominate with attendance, with the SEC and BIG10 having attendance in the 9 digits over the last 20 years. ' captured-sheet='Attendance by Confernece' id='3' />
                  <story-point caption='The SEC averages under 75,000 fans over the past 20 years, more than most NFL stadiums. ' captured-sheet='Avg Attendance per Game by Conference' id='4' />
                  <story-point caption='Nearly all the stadiums featured on this list are part of the BIG10 and SEC.' captured-sheet='Top 10 Stadiums by Avg Attendance' id='5' />
                  <story-point caption='Winning correlates with attendance, but various legacy programs always have consistent attendance despite record. ' captured-sheet='Winning vs Attendance' id='6' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>
      <simple-id uuid='{21A69446-DB92-455B-9A45-F2E2C30242D3}' />
    </dashboard>
  </dashboards>
